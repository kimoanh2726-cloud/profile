  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@react-pdf/renderer": "^4.1.0",
    "framer-motion": "^11.0.0",
    "gsap": "^3.12.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.0",
    "date-fns": "^3.6.0",
