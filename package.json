{
  "name": "profile-hub",
  "version": "1.0.0",
  "description": "Personal Profile Hub — nguồn sự thật duy nhất cho portfolio, CV và hồ sơ học bổng",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "check-build": "tsx scripts/check-build-output.ts",
    "export:cv": "tsx scripts/export-cv.ts",
    "export:scholarship": "tsx scripts/export-scholarship.ts",
    "dev": "next dev",
